{
  "name": "il-mheg-canvas",
  "productName": "ILMhegAgent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first AI image and video canvas",
  "author": "Il Mheg contributors",
  "main": "apps/desktop/dist/main.cjs",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm build:desktop && concurrently -k -n renderer,electron -c magenta,cyan \"pnpm --filter @ilmheg/renderer dev\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:renderer": "pnpm --filter @ilmheg/renderer dev",
    "build": "pnpm build:renderer && pnpm build:desktop",
    "build:renderer": "pnpm --filter @ilmheg/renderer build",
    "build:desktop": "node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:runtime": "node scripts/build-runtime-smoke.mjs && cross-env ELECTRON_RUN_AS_NODE=1 electron .tmp/runtime-smoke.cjs",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm test:runtime",
    "dist": "pnpm verify && electron-builder"
  },
  "build": {
    "appId": "com.ilmheg.canvas",
    "productName": "ILMhegAgent",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "files": [
      "apps/desktop/dist/**/*",
      "apps/renderer/dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "target": ["dmg", "zip"]
    },
    "win": {
      "icon": "build/icon.png",
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.4.21",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wait-on": "9.1.0"
  }
}
